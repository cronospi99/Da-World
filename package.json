{
  "name": "da-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Walk a full 3D city in third person \u2014 the City Explorer world running on the Da World engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/screenshot.mjs",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
